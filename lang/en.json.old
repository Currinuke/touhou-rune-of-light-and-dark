 "encounter_rumia_start": "* The night youkai axe-identally strikes over.",
 "enemy_rumia_dialogue": "Is that so?\n[wait:5]Is that so?",
 "enemy_rumia_check_1_1": "AT 9 DF 2\n[wait:10]* Her headpiece could be a decoration, [wait:5]but it's actually an axe!",
 "enemy_rumia_check_1_2": "If that axe got removed, [wait:5]she'll likely become harmless again.",
 "enemy_rumia_check_2": "AT 9 DF 2\n[wait:10](Come to think of it, even if the axe were removed,\nshe wouldn't exactly be harmless, would she?)",
 "enemy_rumia_turn_1": "* [name:rumia] cannot suppress her desire\nto swing the axe.",
 "enemy_rumia_turn_2": "* [name:rumia] cannot suppress her desire\nto swing the axe.",
 "enemy_rumia_turn_3": "* [name:rumia] cannot suppress her desire\nto swing the axe.",
 "act_rumia_scare_ya": "Scare-ya",
 "act_rumia_scare_ya_description": "Tire a\nenemy",
 "act_rumia_strong_wind": "Strong Wind",
 "act_rumia_strong_wind_description": "Remove\ndarkness",
 "act_rumia_seijas_idea": "[name:seija]'s Idea",
 "act_rumia_seijas_idea_description": "Need\nteam up",
 "act_rumia_scare_ya_text": "* [name:kogasa] scared [name:rumia]!\n[wait:10]* [name:rumia]'s attention wavered a little.",
 "battle_rumia_heal_text_1": "* [name:rumia] was so tense that she absorbed a large amount of darkness.",
 "battle_rumia_heal_text_2": "* [name:rumia]'s attack power increased.",
 "battle_rumia_heal_1": "[speed:0.5]Wh... What?!",
 "battle_rumia_heal_2": "[name:seija], [wait:5]stop attacking! [wait:10]\nYou're making her\nstronger!",
 "battle_rumia_heal_2_alt": "Wait! [wait:5]Stop attacking! [wait:10]\nShe's gotten stronger!",
 "battle_rumia_heal_3": "Make her think I'm scared?",
 "battle_rumia_heal_4": "Pfft, [wait:5]no way I'm doing that!",

 "encounter_remilia_start": "* The Scarlet Devil blocked the\nway!",
 "enemy_remilia_dialogue_1": "You actually have the courage\nto trespass into the Scarlet Devil Mansion,\n[wait:5]Lightners!",
 "enemy_remilia_dialogue_2": "It seems you've long forgotten\nthe fear brought by vampires!",
 "enemy_remilia_dialogue_3": "We are the mighty beings that lurk\nin the night beneath the moonlit sky!",
 "enemy_remilia_dialogue_4": "Even the White Egret will acknowledge\nour strength!\n[wait:5]Our nobility!",
 "enemy_remilia_dialogue_5": "Yes... [wait:5]with this red mist...\n[wait:5]the White Egret will eventually acknowledge us...",
 "enemy_remilia_dialogue_6": "Beneath this crimson moon,\n[wait:5]the sacred fountain will reveal\nanother possibility for fate...",
 "enemy_remilia_dialogue_7": "Don't you understand? [wait:5]The possibility that the world\nwill be ruled by us Darkners!",
 "enemy_remilia_dialogue_8": "Soon, [wait:5]you will all\nlive in despair!",
 "enemy_remilia_dialogue_9_1": "Now then, [wait:5]your journey\nends here!",
 "enemy_remilia_dialogue_9_2": "Face your\ninevitable fate!",
 "enemy_remilia_dialogue_10": "... Uh,\n[wait:5]you really do have\nsome strength!",
 "enemy_remilia_dialogue_11": "... The red mist...\n[wait:5]The glory of the [name:scarlet] family... [wait:5]I...",
 "enemy_remilia_dialogue_12": "... White Egret,\n[wait:5]I won't give up\njust like that...",
 "enemy_remilia_check_1": "A scarlet tyrant who desires to rule everything,\n[wait:5]showing no mercy to anyone.",
 "enemy_remilia_check_2": "Words are useless against her,\n[wait:5]but there might be another way!",
 "enemy_remilia_turn_1": "* It would be an awful night.",
 "enemy_remilia_turn_2": "* It would be a joyful night.",
 "enemy_remilia_turn_3": "* It would be a scary night.",
 "enemy_remilia_turn_4": "* [name:scarlet] gazes at all of you.",
 "enemy_remilia_turn_5": "* Smells like vampire bats.",
 "enemy_remilia_turn_6": "* Moonlight shines through the red mist upon the battlefield.",
 "enemy_remilia_turn_7": "* Moonlight shines through the red mist upon the battlefield.\n[wait:10]* Moonlight is scarlet.",
 "enemy_remilia_turn_8": "* [name:scarlet] gazes at all of you.",
 "enemy_remilia_turn_9": "* It would be a joyful night.",
 "enemy_remilia_turn_10": "* Moonlight shines through the red mist upon the battlefield.",
 "enemy_remilia_turn_11": "* [name:scarlet]'s hand trembles slightly.",
 "act_remilia_kogasa_talk": "Talk",
 "act_remilia_seija_talk": "S-Talk",
 "act_remilia_rin_talk": "R-Talk",
 "act_remilia_me_shield": "{spell_me_shield_name}",
 "act_remilia_scare_burster": "{spell_scare_burster_name}",
 "act_remilia_data_falsifier": "{spell_wind_flower_data_falsifier_name}",
 "battle_remilia_kogasa_talk_attempt": "* [name:tatara_kogasa] attempts to talk...",
 "battle_remilia_kogasa_talk_1": "* Miss [name:scarlet]... [wait:10]Um, well,\n[wait:5]I think we can still talk this out friendly...",
 "battle_remilia_kogasa_talk_2": "* Shut up! [wait:10]Do you really think being a lightner means you're someone great?",
 "battle_remilia_kogasa_talk_3": "* Useless as you\nshould be doomed in the trash!",
 "battle_remilia_kogasa_talk_4": "* Huh...? [wait:5]Huh? [wait:10]How... [wait:5][face:bangs/sad_cry]how could this be? [wait:10]Am I really just a useless tool...?",
 "battle_remilia_kogasa_talk_5": "* [name:kogasa]...? [wait:10]Are you okay?",
 "battle_remilia_kogasa_talk_6": "* ...",
 "battle_remilia_kogasa_talk_change": "* [name:tatara_kogasa]'s will is changing...\n[wait:10]* [color:yellow]TALK[color:reset] became [color:yellow]{spell_me_shield_castName}[color:reset]!",
 "battle_remilia_seija_talk_attempt": "* [name:kijin_seija] attempts to talk...",
 "battle_remilia_seija_talk_1": "* Listen, [wait:5]I...",
 "battle_remilia_seija_talk_2": "* What? [wait:5]You think anyone cares\nabout the thoughts of a twisted creature like you?",
 "battle_remilia_seija_talk_3": "* It's absolutely laughable!",
 "battle_remilia_seija_talk_4": "* ...",
 "battle_remilia_seija_talk_5": "* That's exactly why [wait:5]I hate\nyou higher-ups so much...",
 "battle_remilia_seija_talk_change": "* [name:kijin_seija]'s will is changing...\n[wait:10]* [color:yellow]TALK[color:reset] became [color:yellow]{spell_scare_burster_castName}[color:reset]!",
 "battle_remilia_rin_talk_attempt": "* [name:satsuki_rin] attempts to talk...",
 "battle_remilia_rin_talk_1": "* Can't we just... [wait:5][next]",
 "battle_remilia_rin_talk_2": "* Since when do even blood rations have the right\nto stand before me and speak?",
 "battle_remilia_rin_talk_3": "* Get back to the dungeon!",
 "battle_remilia_rin_talk_4": "* ...",
 "battle_remilia_rin_talk_5": "* Sorry,\n[wait:5]Miss [name:remilia_scarlet].\n[wait:10]My friends and I will never back down!",
 "battle_remilia_rin_talk_6": "* You'd better take back what you just said,\n[wait:5]or we won't hold back!",
 "battle_remilia_rin_talk_change": "* [name:satsuki_rin]'s will is changing...\n[wait:10]* [color:yellow]TALK[color:reset] became [color:yellow]{spell_wind_flower_data_falsifier_castName}[color:reset]!",

 "encounter_flandre_start": "* Let the game begin.",
 "enemy_flandreA_name": "[name:flandre_scarlet] A",
 "enemy_flandreA_check": "After the other unstable factors were split off as clones, she finally reveals her most dignified side.",
 "enemy_flandreB_name": "[name:flandre_scarlet] B",
 "enemy_flandreB_check": "She is the assassin of the team, flying at high speed and dealing heavy damage to enemies.",
 "enemy_flandreC_name": "[name:flandre_scarlet] C",
 "enemy_flandreC_check": "She is the berserker of the team, though she isn't actually as wild as the other clones.",
 "enemy_flandreD_name": "[name:flandre_scarlet] D",
 "enemy_flandreD_check": "She is the magical girl of the team. Don't say in front of her that magical girls aren't a traditional class.",
